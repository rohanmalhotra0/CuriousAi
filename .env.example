# --- Backend ---
DATABASE_URL=postgres://curious:curious@localhost:5432/curiousai
PORT=4000
STORAGE_DIR=./.data/files

# Chat model: deterministic | anthropic | openai | ica | watsonx
AI_PROVIDER=deterministic

# Embedding model: deterministic | openai | watsonx
# Kept separate from the chat model: switching it changes the vector dimension
# and requires re-running migrate + re-indexing all documents. Leave as
# deterministic to flip only the chat model with no re-index.
EMBEDDING_PROVIDER=deterministic
EMBED_DIM=384

# Generation params (shared by all real LLM providers)
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# --- Anthropic (AI_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI (AI_PROVIDER=openai and/or EMBEDDING_PROVIDER=openai) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small   # supports the `dimensions` param -> matches EMBED_DIM

# --- IBM Consulting Advantage / ICA (AI_PROVIDER=ica) ---
ICA_ENDPOINT=https://nextgen-beta.ica.ibm.com/ica
ICA_API_KEY=
# ICA_MODEL=gpt-4o
# ICA_CHAT_PATH=/v1/chat/completions
# ICA_AUTH_HEADER=authorization        # set to `apikey` if the beta uses a custom header
# ICA_AUTH_SCHEME=Bearer               # set to empty if the key is sent raw

# --- watsonx.ai (AI_PROVIDER=watsonx and/or EMBEDDING_PROVIDER=watsonx) ---
# WATSONX_API_KEY=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_PROJECT_ID=
# WATSONX_MODEL=ibm/granite-3-8b-instruct
# WATSONX_EMBED_MODEL=ibm/slate-30m-english-rtrvr   # 384 dims -> matches EMBED_DIM default

# Ingestion guards
MAX_FILE_MB=50
MAX_ZIP_ENTRIES=500

# --- Frontend ---
VITE_API_BASE=http://localhost:4000
