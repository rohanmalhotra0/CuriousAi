# --- Backend ---
DATABASE_URL=postgres://curious:curious@localhost:5432/curiousai
PORT=4000
STORAGE_DIR=./.data/files

# AI provider: deterministic | anthropic | openai | watsonx
AI_PROVIDER=deterministic
EMBED_DIM=384

# Only needed when AI_PROVIDER is a real provider:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Ingestion guards
MAX_FILE_MB=50
MAX_ZIP_ENTRIES=500

# --- Frontend ---
VITE_API_BASE=http://localhost:4000
